# AkerDock instance configuration (instance-config §4).
# Copy to .env and fill in. Never commit .env.

# Image tag — always explicit, never `latest`: an upgrade must be a decision,
# not a side effect of a restart.
AKERDOCK_TAG=v0.1.0

# PostgreSQL password: openssl rand -hex 24
POSTGRES_PASSWORD=

# Public FQDN of the instance.
AKERDOCK_INSTANCE_FQDN=

# Let's Encrypt contact address. Required to issue certificates: without it
# (and without a FQDN to derive one from) a server refuses to bootstrap its
# proxy, rather than let issuance fail silently later.
AKERDOCK_ACME_EMAIL=

# First root user, created only when the database has no user yet (§6.3).
# Once the account exists, these are ignored — change the password from the UI.
AKERDOCK_ROOT_EMAIL=
AKERDOCK_ROOT_NAME=
AKERDOCK_ROOT_PASSWORD=

# Published port of the control plane (UI, API, SSE, terminal — nothing else
# listens).
AKERDOCK_PORT=8080

# This instance's own image, from which the per-server agent helper is deployed
# (ADR-051); leave empty to derive it from AKERDOCK_TAG in the compose.
AKERDOCK_IMAGE=

# Peers whose X-Forwarded-For may be believed (instance-config §2.1); the
# compose defaults to `gateway`, set to the empty string to trust nobody.
AKERDOCK_TRUSTED_PROXIES=gateway
